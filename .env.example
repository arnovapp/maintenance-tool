# Maintenance Tool — environment variables
#
# Copy this file to `.env.local` and fill in values from the listed dashboards.
# Never commit `.env.local`. See `docs/setup.md` for full descriptions.
#
# Variables marked (T0.x) are introduced in that task.

# Supabase (T0.2) — public client, browser-safe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (T0.2) — server-only, full DB access
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (T1.1) — server-only AI calls via Vercel AI SDK
ANTHROPIC_API_KEY=

# Resend (T3.x) — email infra, drafts only in v1
RESEND_API_KEY=
